{
  "name": "IT Assets Checklist",
  "label": {"de": "IT-Ausstattung", "en": "IT Assets Checklist"},
  "fields": [
    {"id": "user", "type": "person", "label": {"de": "Benutzer", "en": "User"}, "required": true,
     "help": {"de": "Wer die Geräte erhält und unterschreibt.", "en": "Who receives the devices and signs."}},
    {"id": "laptop_issued", "type": "checkbox", "label": {"de": "Laptop ausgegeben", "en": "Laptop issued"}},
    {"id": "laptop", "type": "section", "label": {"de": "Laptop", "en": "Laptop"},
     "show_when": {"field": "laptop_issued", "op": "equals", "value": true}},
    {"id": "laptop_model", "type": "dropdown", "section": "laptop", "list": "laptop_models",
     "label": {"de": "Modell", "en": "Model"}, "required": true},
    {"id": "laptop_vendor", "type": "dropdown", "section": "laptop", "list": "hardware_vendors",
     "label": {"de": "Hersteller", "en": "Vendor"}, "required": true},
    {"id": "laptop_serial", "type": "text", "section": "laptop",
     "label": {"de": "Seriennummer", "en": "Serial number"}, "required": true, "max_length": 64},
    {"id": "docking_issued", "type": "checkbox",
     "label": {"de": "Dockingstation ausgegeben", "en": "Docking station issued"}},
    {"id": "docking", "type": "section", "label": {"de": "Dockingstation", "en": "Docking station"},
     "show_when": {"field": "docking_issued", "op": "equals", "value": true}},
    {"id": "docking_model", "type": "dropdown", "section": "docking", "list": "docking_models",
     "label": {"de": "Modell", "en": "Model"}, "required": true},
    {"id": "docking_vendor", "type": "dropdown", "section": "docking", "list": "hardware_vendors",
     "label": {"de": "Hersteller", "en": "Vendor"}, "required": true},
    {"id": "docking_serial", "type": "text", "section": "docking",
     "label": {"de": "Seriennummer", "en": "Serial number"}, "required": true, "max_length": 64},
    {"id": "monitor_issued", "type": "checkbox", "label": {"de": "Monitor ausgegeben", "en": "Monitor issued"}},
    {"id": "monitors", "type": "section", "label": {"de": "Monitor", "en": "Monitor"},
     "show_when": {"field": "monitor_issued", "op": "equals", "value": true},
     "repeat": {"min": 1, "max": 6,
                "add_label": {"de": "Weiteren Monitor hinzufügen", "en": "Add another monitor"}}},
    {"id": "monitor_model", "type": "dropdown", "section": "monitors", "list": "monitor_models",
     "label": {"de": "Modell", "en": "Model"}, "required": true},
    {"id": "monitor_vendor", "type": "dropdown", "section": "monitors", "list": "hardware_vendors",
     "label": {"de": "Hersteller", "en": "Vendor"}, "required": true},
    {"id": "monitor_serial", "type": "text", "section": "monitors",
     "label": {"de": "Seriennummer", "en": "Serial number"}, "required": true, "max_length": 64},
    {"id": "smartphone_issued", "type": "checkbox",
     "label": {"de": "Smartphone ausgegeben", "en": "Smartphone issued"}},
    {"id": "smartphone", "type": "section", "label": {"de": "Smartphone", "en": "Smartphone"},
     "show_when": {"field": "smartphone_issued", "op": "equals", "value": true}},
    {"id": "smartphone_model", "type": "dropdown", "section": "smartphone", "list": "smartphone_models",
     "label": {"de": "Modell", "en": "Model"}, "required": true},
    {"id": "smartphone_vendor", "type": "dropdown", "section": "smartphone", "list": "hardware_vendors",
     "label": {"de": "Hersteller", "en": "Vendor"}, "required": true},
    {"id": "imei", "type": "text", "section": "smartphone", "label": {"de": "IMEI", "en": "IMEI"},
     "required": true, "max_length": 20},
    {"id": "pin", "type": "secret", "section": "smartphone", "label": {"de": "PIN", "en": "PIN"}},
    {"id": "puk", "type": "secret", "section": "smartphone", "label": {"de": "PUK", "en": "PUK"}},
    {"id": "unlock_pin", "type": "secret", "section": "smartphone",
     "label": {"de": "Entsperr-PIN", "en": "Unlock PIN"}},
    {"id": "notes", "type": "longtext", "label": {"de": "Bemerkungen", "en": "Notes"}, "max_length": 2000},
    {"id": "signature", "type": "signature", "label": {"de": "Unterschrift", "en": "Signature"}}
  ],
  "steps": [
    {
      "id": "user_signs",
      "type": "sign",
      "label": {"de": "Empfang bestätigen und unterschreiben", "en": "Confirm receipt and sign"},
      "who": {"kind": "field", "field": "user"},
      "fields": ["signature"],
      "allow_paper": true
    },
    {
      "id": "copy_to_user_and_it",
      "type": "notify",
      "label": {"de": "Unterschriebenes PDF an Benutzer und IT", "en": "Signed PDF to user and IT"},
      "who": [{"kind": "field", "field": "user"}, {"kind": "group", "group": "IT"}],
      "attach_pdf": true
    }
  ]
}
